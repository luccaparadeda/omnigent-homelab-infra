VAULT_IMAGE={{ vault_image }}
VAULT_BIND_IP={{ vault_private_ip | default('127.0.0.1', true) }}
VAULT_API_ADDR={{ vault_api_addr | default('https://not-configured.invalid:8200', true) }}
VAULT_CLUSTER_ADDR={{ vault_cluster_addr | default('https://not-configured.invalid:8201', true) }}
VAULT_OCIKMS_SEAL_KEY_ID={{ oci_kms_key_id | default('NOT_CONFIGURED', true) }}
VAULT_OCIKMS_CRYPTO_ENDPOINT={{ oci_kms_crypto_endpoint | default('NOT_CONFIGURED', true) }}
VAULT_OCIKMS_MANAGEMENT_ENDPOINT={{ oci_kms_management_endpoint | default('NOT_CONFIGURED', true) }}
VAULT_DATA_ROOT={{ vault_data_root }}
VAULT_TLS_ROOT={{ vault_tls_root }}
