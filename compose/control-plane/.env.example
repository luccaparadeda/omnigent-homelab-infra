# Copy to .env on the server and replace every CHANGE_ME value.
# Never commit the populated file.

OMNIGENT_BASE_IMAGE=ghcr.io/omnigent-ai/omnigent-server@sha256:b211b81fb739a7be9b326603d54511cc1f1e2f91f311b85ac2ea144c85129d56
OMNIGENT_SERVER_IMAGE=local/omnigent-server-vault:0.19.1-hvac2.4.0
POSTGRES_IMAGE=postgres@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b

OMNIGENT_BIND_IP=127.0.0.1
OMNIGENT_PORT=8000
OMNIGENT_BASE_URL=https://CHANGE_ME_PRIVATE_NAME

POSTGRES_USER=omnigent
POSTGRES_DB=omnigent
POSTGRES_PASSWORD=CHANGE_ME
OMNIGENT_ACCOUNTS_COOKIE_SECRET=CHANGE_ME
OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=CHANGE_ME

# Leave blank during the first non-credential-store smoke test.
# Production target: vault.
OMNIGENT_CREDENTIAL_CIPHER=
OMNIGENT_CREDENTIAL_VAULT_KEY=omnigent-credentials
OMNIGENT_CREDENTIAL_VAULT_MOUNT=transit
VAULT_ADDR=https://CHANGE_ME_PRIVATE_VAULT_NAME:8200
VAULT_TOKEN=CHANGE_ME_NARROW_SCOPED_TOKEN
VAULT_CA_ROOT=/etc/omnigent/vault-ca

# Persistent data lives on the server's encrypted data volume.
OMNIGENT_DATA_ROOT=/srv/omnigent
