# Copy to .env only on the Vault VM. Never commit the populated file.

VAULT_IMAGE=hashicorp/vault@sha256:962a92876e168d68eaaa24b0b8b49bbce1cb63024060a67bba95cd158a366fc2
VAULT_BIND_IP=127.0.0.1
VAULT_API_ADDR=https://CHANGE_ME_PRIVATE_VAULT_NAME:8200
VAULT_CLUSTER_ADDR=https://CHANGE_ME_PRIVATE_VAULT_NAME:8201

# OCI KMS auto-unseal. The VM should use an OCI instance principal.
VAULT_OCIKMS_SEAL_KEY_ID=CHANGE_ME_KEY_OCID
VAULT_OCIKMS_CRYPTO_ENDPOINT=https://CHANGE_ME-crypto.kms.CHANGE_ME_REGION.oraclecloud.com
VAULT_OCIKMS_MANAGEMENT_ENDPOINT=https://CHANGE_ME-management.kms.CHANGE_ME_REGION.oraclecloud.com

VAULT_DATA_ROOT=/srv/vault
VAULT_TLS_ROOT=/etc/omnigent/vault/tls
