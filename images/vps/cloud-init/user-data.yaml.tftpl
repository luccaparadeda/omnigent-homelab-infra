#cloud-config
hostname: omnigent-${role}
manage_etc_hosts: true

users:
  - default
  - name: ops
    gecos: Omnigent operator
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - jq
  - python3
  - python3-apt
  - unattended-upgrades

write_files:
  - path: /etc/omnigent-node-role
    owner: root:root
    permissions: "0644"
    content: |
      ${role}
  - path: /etc/sysctl.d/60-omnigent-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1

runcmd:
  - [systemctl, enable, --now, unattended-upgrades]
  - [sysctl, --system]
  - [mkdir, -p, /srv/omnigent, /srv/vault]
  - [chmod, "0750", /srv/omnigent, /srv/vault]

final_message: "Base node ${role} is ready for private-network enrollment and Ansible."
