#cloud-config
autoinstall:
  version: 1
  interactive-sections:
    - storage
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: home-worker
    username: ops
    # Locked account: SSH key access only.
    password: "!"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 REPLACE_WITH_OPERATOR_PUBLIC_KEY
  packages:
    - python3
    - python3-apt
    - qemu-guest-agent
  updates: security
  shutdown: reboot
