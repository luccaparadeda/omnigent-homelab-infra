#cloud-config
# Copy outside Git, replace the public key, and pair with a unique meta-data file.
hostname: home-worker
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
ssh_deletekeys: true
ssh_genkeytypes: [ed25519, ecdsa, rsa]

users:
  - default
  - name: ops
    gecos: Omnigent worker operator
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 REPLACE_WITH_OPERATOR_PUBLIC_KEY

runcmd:
  - [ssh-keygen, -A]

final_message: "Unique worker clone identity initialized."
